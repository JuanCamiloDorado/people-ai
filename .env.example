# Configuracion del Servidor y Entorno
NODE_ENV=development
PORT=3000

# Base de Datos (MySQL / TiDB)
# Ejemplo local: mysql://usuario:contrasena@localhost:3306/people_ai
# En produccion apunta a TiDB Cloud: puerto 4000 y TLS obligatorio (server/dbSsl.ts
# lo activa solo con hosts remotos, asi que la misma cadena sirve tal cual).
DATABASE_URL=mysql://root:root@localhost:3306/people_ai

# Secreto de sesion. OBLIGATORIO: minimo 32 caracteres, el servidor no arranca sin el.
# Genera uno con:  openssl rand -hex 32
# Rotarlo cierra la sesion de todos los usuarios.
JWT_SECRET=

# Catalogo LLM incorporado de la plantilla Manus (server/_core/llm.ts). Solo lo
# necesita el modo "real" de la IA; el modo demo funciona sin esto. NO tiene nada que
# ver con el almacenamiento de documentos, aunque el nombre lo sugiera.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Almacenamiento S3-compatible de los documentos del portal del candidato. Sirve
# cualquier proveedor con API S3: Cloudflare R2, Backblaze B2, AWS S3 o MinIO en
# local. Sin estas variables el servidor arranca igual y el resto de la aplicacion
# (login, empresas, usuarios) funciona; lo unico que cae es subir y descargar
# documentos, y el log de arranque lo avisa.
#
# Endpoint vacio = AWS S3 real, resuelto por region. Para R2:
#   STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   STORAGE_S3_REGION=auto        <- R2 exige exactamente "auto"
# Para MinIO en local, sin cambiar una linea de codigo:
#   STORAGE_S3_ENDPOINT=http://localhost:9000
#   STORAGE_S3_REGION=us-east-1
#   STORAGE_S3_FORCE_PATH_STYLE=true
#
# Usa un token acotado a un solo bucket, nunca una clave de cuenta, y crea el bucket
# con el acceso publico bloqueado: las URLs firmadas son la unica via de lectura.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false

# Configuracion de Dominio / Procesos
REMINDER_COOLDOWN_HOURS=4

# Heredadas de la plantilla Manus. Ningun modulo las lee; estan en el .env local y
# se declaran aqui para que el ejemplo refleje el entorno real.
VITE_APP_ID=
OWNER_OPEN_ID=
